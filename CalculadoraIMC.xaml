<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticaUI.CalculadoraIMC"
             Title="CalculadoraIMC">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            <Label Text="Calculadora IMC" FontSize="24" FontAttributes="Bold"
                   TextColor="#0ED9F0" HorizontalOptions="Center" />

            <!-- Campo para agregar el Peso -->
            <Label Text="Peso (KG)" TextColor="Black" FontAttributes="Bold" />
            <!-- CORREGIDO: RoundRectangle en lugar de RoundRectangulo -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0">
                <Entry x:Name="txtPeso" Placeholder="70.5" Keyboard="Numeric" />
            </Border>

            <!-- Campo Altura -->
            <Label Text="Altura (metros)" TextColor="Black" FontAttributes="Bold" />
            <!-- 
RoundRectangle en lugar de RoundRectangulo -->
            <Border Stroke="Black" StrokeShape="RoundRectangle 8" Padding="5,0">
                <Entry x:Name="txtAltura" Placeholder="Ejemplo 1.75" Keyboard="Numeric" />
            </Border>

            <!-- Boton -->
            <Button Text="Calcular IMC" Background="#4A0BD6" TextColor="White"
                    FontAttributes="Bold" CornerRadius="8" HeightRequest="48" Clicked="Button_Clicked"/>

            <!-- Tarjeta de resultado -->
            <Border x:Name="brResultado" StrokeShape="RoundRectangle 12" Padding="20" IsVisible="False" Margin="0,10,0,0">
                <VerticalStackLayout>
                    <Label x:Name="lblValorIMC" FontSize="32" FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label x:Name="lblDiagnostico" FontSize="16" FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- NUEVO: Guía de rangos de IMC debajo del resultado -->
            <Border Stroke="#CCCCCC" StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="#F9F9F9" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Rangos de Referencia IMC" FontSize="14" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                    <Label Text="• Bajo peso: Menos de 18.5" FontSize="12" TextColor="#555555" />
                    <Label Text="• Peso normal: 18.5 – 24.9" FontSize="12" TextColor="#555555" />
                    <Label Text="• Sobrepeso: 25.0 – 29.9" FontSize="12" TextColor="#555555" />
                    <Label Text="• Obesidad: 30.0 o más" FontSize="12" TextColor="#555555" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>